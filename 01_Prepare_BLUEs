library("asreml") 
library("dplyr")
library("tibble")
library("tidyr")

asreml.options(maxit=500, workspace="10gb")
################################################
#A) load input
################################################

input                 = readRDS("/home/tasha/WP1/data/Countries_combined.rds") 

################################################
#B) Function for spatial effects
################################################

spatial_effects       = function(input) {

      converged             = data.frame()
      nonconverged          = data.frame()
      model_list            = list()
        
    for(current_country in names(input)) {
   
      model_list[[current_country]] = list()
      
      data_list             = input[[current_country]] %>% split(.$trait_raw) 
    
    for(current_trait in names(data_list)) {
    print(paste("Country: ", current_country, "and trait", current_trait))

      data_subset           = data_list[[current_trait]] %>% as.data.frame() %>%
                              mutate(year_numeric = as.numeric(year)) %>% 
                              mutate_at(c("column", "row"), as.numeric)
                                                       
             if (current_country %in% c("Denmark")) {                   
      
      data_subset           = data_subset %>% 
                              arrange(year_numeric, column, row) %>%
                              mutate_at(c("line", "year", "column", "row"), as.factor) %>% droplevels()
                              
      MA1                   = "~idv(year):ar1(column):ar1(row) + idv(year) + idv(year):id(trial) + idv(year):id(line)"                        
      MA2                   = "~ar1v(column):ar1(row) + idv(trial)"  
      
      MB1                   = "~idv(year):ar1(column):ar1(row) + idv(year) + idv(year):id(line)"                        
      MB2                   = "~ar1v(column):ar1(row)"  
                        
      } else if (current_country %in% c("Iceland", "Lithuania")) { 
      
      data_subset           = data_subset %>% 
                              arrange(year_numeric, rep, column, row) %>%
                              mutate_at(c("line", "year", "rep", "column", "row"), as.factor) %>% droplevels()  
                              
      MA1                   = "~idv(year):id(rep):ar1(column):ar1(row) + idv(year):id(rep) + idv(year) + idv(year):id(line)"                        
      MA2                   = "~idv(rep):ar1(column):ar1(row) + idv(rep)" 
      
      MB1                   = "~idv(year):id(rep):ar1(column):ar1(row) + idv(year) + idv(year):id(line)"                        
      MB2                   = "~idv(rep):ar1(column):ar1(row)" 
                                                                  
                              
      } else if (current_country %in% c("Estonia", "Finland", "Norway", "Sweden")) {  
      
      data_subset           = data_subset %>% 
                              arrange(year_numeric, trial, column, row) %>%
                              mutate_at(c("line", "year", "trial", "column", "row"), as.factor) %>% droplevels() 
                              
      MA1                   = "~idv(year):id(trial):ar1(column):ar1(row) + idv(year):id(trial) + idv(year) + idv(year):id(line)"  
      MA2                   = "~idv(trial):ar1(column):ar1(row) + idv(trial)" 
      
      MB1                   = "~idv(year):id(trial):ar1(column):ar1(row) + idv(year) + idv(year):id(line)"  
      MB2                   = "~idv(trial):ar1(column):ar1(row)"   }                      
    
      country_trait         = paste0(current_country,"_",current_trait)
      success               = FALSE
      
        modelA1 <- modelB1 <- modelA2 <- modelB2 <- NULL
      
      if(length(unique(data_subset$year)) == 2 ) {
      print("Running model over two years")
      
      tryCatch({
      modelA1               = asreml(fixed     = phenotype_raw ~ -1 + line,
                                     random    = as.formula(MA1),
                                     residual  = ~idv(units),
                                     na.action =  na.method(x = "omit", y = "omit"),
                                     data      =  data_subset)
      success               = modelA1$converge  }, error = function(e) { cat(paste("ModelA1 failed for =", country_trait, "\n")) })  
      
      if (!success) {
      tryCatch({
      modelB1               = asreml(fixed     = phenotype_raw ~ -1 + line,
                                     random    = as.formula(MB1),
                                     residual  = ~idv(units),
                                     na.action =  na.method(x = "omit", y = "omit"),
                                     data      =  data_subset)
      success               = modelB1$converge  }, error = function(e) { cat(paste("ModelB1 failed for =", country_trait, "\n")) }) } 
      
                                                 } else {
      print("Running model over one year")
                        
      tryCatch({
      modelA2               = asreml(fixed     = phenotype_raw ~ -1 + line,
                                     random    = as.formula(MA2),
                                     residual  = ~idv(units),
                                     na.action =  na.method(x = "omit", y = "omit"),
                                     data      =  data_subset)
      success               = modelA2$converge  }, error = function(e) { cat(paste("ModelA2 failed for =", country_trait, "\n")) })                 
                        
      if (!success) {
      tryCatch({
      modelB2               = asreml(fixed     = phenotype_raw ~ line,
                                     random    = as.formula(MB2),
                                     residual  = ~idv(units),
                                     na.action = na.method(x = "omit", y = "omit"),
                                     data      = data_subset)
      success               = modelB2$converge  }, error = function(e) { cat(paste("ModelB2 failed for =", country_trait, "\n")) }) } }

          
        if (success) {
    if (!is.null(modelA1) && modelA1$converge == TRUE) {
        model_output = predict(modelA1, classify="line:year")
        model_name   = "modelA1"
        
    } else if (!is.null(modelB1) && modelB1$converge == TRUE) {
        model_output = predict(modelB1, classify="line:year")
        model_name   = "modelB1"
        
    } else if (!is.null(modelA2) && modelA2$converge == TRUE) {
        model_output = predict(modelA2, classify="line")
        model_name   = "modelA2"
    
    } else {
        model_output = predict(modelB2, classify="line")
        model_name   = "modelB2" } 
         
        model_list[[current_country]][[current_trait]] = get(model_name)
        
        temp_output  = model_output$pvals %>% as.data.frame() %>%
                       mutate("country" = current_country, "trait" = current_trait, "model" = model_name, "convergence" = get(model_name)$converge) %>%                       rename("id" = "line") %>% mutate(id = as.character(id)) 
                         
        if(!"year" %in% colnames(temp_output)) {
        temp_output$year = unique(data_subset$year) }   
        
        converged    = rbind(temp_output, converged)
        
                } else {
      
       model_list[[current_country]][[current_trait]]  = NA
        
       print(paste("Country", current_country, "and trait", current_trait, "--------------------------------------- did not converge"))
       
       nonconverged  = rbind(nonconverged, data.frame("country" = current_country, "trait" = current_trait)) } 
       
       } #current trait
        
       saveRDS(model_list[[current_country]], paste0("/home/tasha/WP1/results/models/", current_country,".rds"))
       
       } #current country
        
       saveRDS(converged, paste0("/home/tasha/WP1/results/BLUES/BLUES_final.rds"))
        
       return(nonconverged) } 
################################################
#C) Run function
################################################

spatial_effects(input = input)

################################################
#D) Make function to extract qqplots
################################################

countries    = c("Denmark", "Estonia", "Finland", "Iceland", "Lithuania", "Norway", "Sweden")

for(current_country in countries) {

pdf(paste0("/home/tasha/WP1/results/BLUES/", current_country, ".pdf"))
  
model_list   = readRDS(paste0("/home/tasha/WP1/results/models/", current_country, ".rds"))
  
for(current_trait in names(model_list)) {

try({
par(mar = c(4, 4, 2, 1))     
plot.new()
plot(model_list[[current_trait]], res = "default", spatial = "trend", facet = FALSE)    
mtext(paste0("Country: ", current_country, ", and trait: ", current_trait), side = 3, line = 1, cex = 1, font = 2, col = "black") }, silent = TRUE) }
  
dev.off() }

