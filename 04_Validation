#############################################################
#B) Prepare Kernels
#############################################################

prepare_env_matrices= function(trait_type) {
 
        if(trait_type == "yield") {
W        = EC_matrices[["W_yield"]]
E        = EC_matrices[["E_yield"]]

 } else if(trait_type == "nonyield") {

W        = EC_matrices[["W_WIK_SPC"]]
E        = EC_matrices[["E_WIK_SPC"]]  }

matrices = list("A" = G_matrices[["GRM_A"]], "D" = G_matrices[["GRM_D"]], "W"= W, "ET" = E)
        
AxW      = kronecker(matrices[["A"]], matrices[["W"]],  make.dimnames = TRUE)
AxET     = kronecker(matrices[["A"]], matrices[["ET"]], make.dimnames = TRUE)
DxW      = kronecker(matrices[["D"]], matrices[["W"]],  make.dimnames = TRUE)
DxET     = kronecker(matrices[["D"]], matrices[["ET"]], make.dimnames = TRUE)

kronck_matrices      = list("AxW" = AxW, "AxET" = AxET, "DxW"= DxW, "DxET" = DxET)
  
input_matrices       = c(matrices, kronck_matrices)

for (i in names(input_matrices)) {
  
input_matrices[[i]]  = Matrix::nearPD(input_matrices[[i]])$mat %>% as.matrix() }

covariance_matrices  = list("A"    = input_matrices[["A"]],
                            "D"    = input_matrices[["D"]],
                            "W"    = input_matrices[["W"]],
                            "ET"   = input_matrices[["ET"]],
                            "AxW"  = input_matrices[["AxW"]],
                            "AxET" = input_matrices[["AxET"]],
                            "DxW"  = input_matrices[["DxW"]],
                            "DxET" = input_matrices[["DxET"]])  

return(covariance_matrices) }
#############################################################

Kernels_yield        = prepare_env_matrices("yield")
Kernels_nonyield     = prepare_env_matrices("nonyield")
                                               
#############################################################
#C) Function to create incidence matrices and model list
#############################################################

create_incidence_mat = function(input_matrices, data, model) {
  
Z_G                  = t(sapply(as.character(data$id), function(x) as.numeric(rownames(input_matrices[["A"]]) == x)))
Z_Env                = t(sapply(as.character(data$country_year), function(x) as.numeric(rownames(input_matrices[["W"]]) == x)))
Z_GxEnv              = t(sapply(as.character(data$id_country_year), function(x) as.numeric(rownames(input_matrices[["AxW"]]) == x)))
Z_error              = diag(1, nrow(data))
  
         if (model %in% c("M1A", "M1B")) {

ZL                   = list("A" = Z_G, "Env" = Z_Env, "Error" = Z_error)
    
  } else if (model %in% c("M2A", "M2B")) {
  
ZL                   = list("A" = Z_G, "Env" = Z_Env, "AxEnv" = Z_GxEnv, "Error" = Z_error)
    
  } else if (model %in% c("M3A", "M3B")) {
  
ZL                   = list("A" = Z_G, "D" = Z_G, "Env" = Z_Env, "AxEnv" = Z_GxEnv, "DxEnv" = Z_GxEnv, "Error" = Z_error) }
  
return(ZL) }

