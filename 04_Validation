#############################################################
#E) Function for validation
#############################################################

Validation = function(input_list, validation_scheme) {

  output   = data.frame()
    
  for(trait in names(input_list)) {
  print(trait)
  
          if (trait %in% c("TDM3")) {
   
   covariance_matrices  = Kernels_yield
   
   } else if (trait %in% c("SpringCover", "WinterKill")) { 
   
   covariance_matrices  = Kernels_nonyield }
  
  data_subset           = input_list[[trait]] %>% mutate_at(vars("id", "country", "country_year", "id_country_year"), as.character) %>%
                          mutate(year = factor(year, levels = c("2015", "2016")))
              
  folds                 = unique(data_subset[[validation_scheme]]) %>% na.omit() %>% as.vector()
                               
  for(current_fold in folds) {
  
  data_train            = data_subset %>% filter(.data[[validation_scheme]] != current_fold) 
  data_test             = data_subset %>% filter(.data[[validation_scheme]] == current_fold) 
  y_observed            = data_test %>% select(c("y_z_scaled", "id", "country_year"))       
  
  print(paste("data_train", nrow(data_train), "data_test", nrow(data_test)))                   
  
  formula               = as.formula('~ 1') 
  X_test                = model.matrix(y_z_scaled ~ 1, data_test)                                                
      
  for(current_model in names(model_list)) {
  
  Z_train               = create_incidence_mat(covariance_matrices, data_train, current_model)
  Z_test                = create_incidence_mat(covariance_matrices, data_test,  current_model)
  Z_test[["Error"]]     = NULL

  cov_list              = model_list[[current_model]]
  V_list                = covariance_matrices[cov_list]
  V_list[["Error"]]     = diag(1, nrow(data_train))
         
  tryCatch({
   
  fixed_effects         = MMEst(Y =data_train$y_z_scaled,                                                       
                          Cofactor=data_train, formula = formula, ZList = Z_train, VarList = V_list, Method = "ML")
                                
  random_effects        = MMBlup(Y=data_train$y_z_scaled,                                                        
                          Cofactor=data_train, fmla = formula,    ZList = Z_train, VarList = V_list, ResMM = fixed_effects)
  
  u_list                = random_effects[names(random_effects) != "Error"]
  
  b                     = fixed_effects[["NullModel"]][["Beta"]] %>% as.vector()
  
  BLUEs                 = (X_test %*% b) %>% as.data.frame() %>% rename("BLUEs" = "V1")
  
  BLUPs                 = NULL
  
  BLUPs                 = foreach(i = seq_along(u_list), .combine = `cbind`) %do% {
  
  out                   = Z_test[[i]] %*% u_list[[i]] %>% as.data.frame() %>% 
                          rownames_to_column(var = names(Z_test)[i]) %>% 
                          rename(!!paste0("BLUPs_", names(Z_test)[i]) := "V1") } %>%
                          mutate(BLUPs = rowSums(select(., starts_with("BLUP")))) %>%
                          mutate(A   = str_remove(A, "\\..*"),
                                 A   = str_remove(A, "^X"),
                                 Env = str_remove(Env, "\\..*")) %>% 
                          rename("country_year" = "Env") %>% 
                          rename("id" = "A") 
                          
   BLUPs                = BLUPs %>% select(-intersect(names(BLUPs), c("D", "AxEnv", "DxEnv")))
                          
   for (col in c("BLUPs_D", "BLUPs_DxEnv", "BLUPs_AxEnv")) {
   if (!(col %in% colnames(BLUPs))) BLUPs[[col]] <- NA }
                      
  effect                = cbind(BLUEs, BLUPs) %>% as.data.frame() %>% 
                          mutate(ypred = BLUEs + BLUPs) %>% 
                          left_join(y_observed, by = c("id", "country_year")) %>%
                          rename("yobs" = "y_z_scaled") %>%                                                    
                          mutate("trait" = trait, "model" = current_model, "validation_scheme" = validation_scheme, "fold" = current_fold) 
                          
  output                = rbind(effect, output) }, warning = function(w) { cat("Warning occurred:", conditionMessage(w), "\n") },
                                                   error   = function(e) { cat("Error occurred:",   conditionMessage(e), "\n") })  }}}
                                                   
  output                = output[, c("id", "country_year", setdiff(names(output), c("id", "country_year")))]                         
  
  saveRDS(output, paste0(path_output, "Validation/Validation_",validation_scheme,".rds")) 
            
  return() }
