n                = ncol(readRDS(paste0(path_matrices, "Kinships_and_geno.rds"))[["A_centered"]])
 
#############################################################
#B) Extract pvalues for marginal effects 
#############################################################

Extract_pvalues_marginal = function(GWAS) {

pval_output      = data.frame()

for(trait in traits) {
print(trait) 

current_GWAS     = GWAS[[trait]]

SNP_results      = lapply(names(current_GWAS), function(SNP) {

tryCatch({
sig              = aod::wald.test(Sigma = current_GWAS[[SNP]]$VarBeta, b = current_GWAS[[SNP]]$Beta, 
                   Terms = which(names(current_GWAS[[SNP]]$Beta) %in% c("Additive")))$result$chi2["P"]

data.table("Pval"= sig, "trait" = trait, "SNP" = SNP, "Analysis" = "Marginal")  }, error = function(e) {
data.table("Pval"= NA,  "trait" = trait, "SNP" = SNP, "Analysis" = "Marginal")  }) }) 

SNP_results      = rbindlist(SNP_results)
pval_output      = rbind(pval_output, SNP_results) }

return(pval_output) }

#############################################################
#C) Extract pvalues for conditional effects 
#############################################################

Extract_pvalues_conditional = function(GWAS) {

pval_output      = data.frame()

for(trait in traits) {
print(trait) 

current_GWAS     = GWAS[[trait]]

SNP_results      = lapply(names(current_GWAS), function(SNP) {
        
VarBeta          = current_GWAS[[SNP]]$VarBeta
Beta             = current_GWAS[[SNP]]$Beta

terms_to_use     = which(rownames(VarBeta) %in% c("Additive:countryDenmark", 
                                                  "Additive:countryEstonia", 
                                                  "Additive:countryFinland", #Finland removed from analysis
                                                  "Additive:countryIceland",
                                                  "Additive:countryLithuania", 
                                                  "Additive:countryNorway",
                                                  "Additive:countrySweden"))
                                            
sig              = aod::wald.test(Sigma = VarBeta, b = Beta, Terms = c(terms_to_use))$result$chi2["P"]

data.table("Pval"= sig, "trait" = trait, "SNP" = SNP, "Analysis" = "Conditional") }) 

SNP_results      = rbindlist(SNP_results)

pval_output      = rbind(pval_output, SNP_results) }

pval_output      = pval_output %>% as.data.frame() 

return(pval_output) }

#############################################################
#D) Run functions
#############################################################

pval_marginal    = Extract_pvalues_marginal(GWAS_marginal) %>% as.data.frame() %>% split(.$trait)
saveRDS(pval_marginal,  paste0(path_input, "GWAS_marginal_pvalues.rds"))

pval_conditional = Extract_pvalues_conditional(GWAS_conditional) %>% as.data.frame() %>% split(.$trait)
saveRDS(pval_conditional, paste0(path_input,"GWAS_conditional_pvalues.rds"))

#############################################################
#E) Manhattan plots
#############################################################

colors           = viridis(10)
color_vector     = c("Marginal" = colors[1], "Conditional" = colors[5])

Mplot            = list()
pvalues          = data.frame()
  
for(trait in traits){  
   
#Calculate FDR     
pval_marginal[[trait]]$FDR    = p.adjust(pval_marginal[[trait]]$Pval, "fdr")        
pval_conditional[[trait]]$FDR = p.adjust(pval_conditional[[trait]]$Pval,"fdr") 

#Prepare table  
temp_output      = rbind(pval_marginal[[trait]], pval_conditional[[trait]]) %>% filter(FDR <= 0.10) 
pvalues          = rbind(temp_output, pvalues)

#Prepare input for Manhattan plot
current_data     = rbind(pval_marginal[[trait]], pval_conditional[[trait]]) %>% 
                   mutate(Chr = str_extract(SNP, "^[^_]+"), Position = sub(".*_", "", SNP)) %>%
                   mutate(Analysis = factor(Analysis, levels = c("Marginal", "Conditional")))  
 
Mplot[[trait]]   = ggplot() + 
                   geom_point(data = current_data, aes(x = Position, y = -log10(FDR), colour = Analysis), alpha = 0.75, size =1.5) +
                   facet_grid(. ~ Chr, scales = "free_x", space = "free_x") + 
                   geom_hline(yintercept  = -log10(0.05), linetype = "dashed", color = "black") +
                   geom_hline(yintercept  = -log10(0.10), linetype = "dashed", color = "grey") +
                   theme(axis.text.x      = element_blank(),
                   panel.background       = element_blank(),
                   panel.grid.major       = element_blank(), 
                   panel.grid.minor       = element_blank(),
                   axis.line              = element_line(colour = "black"),
                   strip.background       = element_blank(),
                   plot.title             = element_text(size = 14, hjust = 0.5)) + ylim(0, 4) +
                   scale_color_manual(values = color_vector) +
                   ylab(expression(-Log[10] ~ "(FDR)")) +
                   ggtitle(trait)  }
  
All_traits_plot  = ggpubr::ggarrange(Mplot[["TDM3"]],Mplot[["SpringCover"]],Mplot[["WinterKill"]],ncol=3,nrow=1,common.legend=TRUE,legend="bottom")  
All_traits_plot  = ggpubr::annotate_figure(All_traits_plot, top = text_grob(""))  
ggsave(paste0(path_results, "figures/GWAS/Manhattan_final.png"), plot = All_traits_plot, width = 24, height = 8, unit = 'cm')

pvalues_upd      = pvalues %>% 
                   select(c("Analysis", "trait", "SNP", "Pval", "FDR")) %>% 
                   mutate(CHR     = str_extract(SNP, "^[^_]+"), POS = sub(".*_", "", SNP),
                          FDR     = format(as.numeric(FDR),  scientific = TRUE, digits = 3),
                          Pval    = format(as.numeric(Pval), scientific = TRUE, digits = 3)) %>%
                   mutate(Pval = as.numeric(Pval), FDR = as.numeric(FDR)) %>%
                   mutate(threshold = case_when(FDR <= 0.10 & FDR > 0.05 ~0.10, FDR <= 0.05 & FDR > 0.01 ~0.05, FDR <= 0.01 ~0.01,TRUE ~NA_real_)) %>% 
                   arrange(trait, Analysis, CHR, POS, SNP, Pval, FDR) %>%
                   distinct(trait, Analysis, CHR, POS, SNP, Pval, FDR)

saveRDS(pvalues_upd, paste0(path_input, "Pvalues_significant.rds")) 

#############################################################
