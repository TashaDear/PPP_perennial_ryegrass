path             = "/home/tasha/QGG_plants/ppp_updated/"
path_input       = paste0(path, "results/model_output/GWAS/")
path_matrices    = paste0(path, "input/matrices/")
path_results     = paste0(path, "results/")

#Load input
GWAS_marginal    = readRDS(paste0(path_input, "GWAS_marginal_final.rds"))
GWAS_conditional = readRDS(paste0(path_input, "GWAS_conditional_final.rds"))

