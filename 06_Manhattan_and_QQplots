#############################################################
#H) Prepare input for conditional plots
#############################################################

Conditional_df    = data.frame() 
for(current_trait in traits) {

current_pval      = pvalues_upd %>% filter(Analysis == "Conditional") %>% filter(trait == current_trait)

for(SNP in unique(current_pval$SNP)) {

Sigma             = GWAS_conditional[[current_trait]][[SNP]]$VarBeta
colnames(Sigma)   = rownames(Sigma)
Sigma             = diag(Sigma) %>% as.data.frame() %>% rename("Sigma" = ".") %>% rownames_to_column("Country")
Beta              = GWAS_conditional[[current_trait]][[SNP]]$Beta %>% as.data.frame() %>% rename("Beta" = ".") %>% rownames_to_column("Country")

temp              = Sigma %>% left_join(Beta, by = "Country") %>%
                    filter(!Country %in% c("PC1", "PC2", "PC3", "Additive", "country", 
                                           "countryDenmark", "countryEstonia", "countryFinland", "countryLithuania", "countryIceland", 
                                           "countrySweden", "countryNorway", "(Intercept)", "year2015", "year2016")) %>%
                    mutate(trait = current_trait, SNP = SNP, SE = sqrt(Sigma), Country = str_replace(Country, "Additive:country", ""))

Conditional_df    = rbind(Conditional_df, temp) }}

Conditional_input = pvalues_upd[,c("trait", "SNP", "Analysis", "Pval", "FDR")] %>% 
                    filter(Analysis == "Conditional") %>% 
                    left_join(Conditional_df, by = c("SNP", "trait")) 
  
#Select three most significant SNPs for each trait                    
Prioritized_SNPs  = Conditional_input %>% distinct(trait, SNP, Pval, FDR) %>% group_by(trait) %>% slice_min(Pval, n = 3) %>% ungroup()
Conditional_sub   = Conditional_input %>% semi_join(Prioritized_SNPs, by = c("trait", "SNP")) 
                                      
#############################################################
#I) Prepare plot for conditional effects
#############################################################
       
desired_order     = c("Denmark", "Iceland", "Lithuania", "Norway", "Sweden", "Estonia")
country_colors    = c("Norway"="#A50026", "Estonia"="#D73027", "Sweden"="#F46D43", "Lithuania"="#74ADD1", "Iceland"="#4575B4", "Denmark"="#313695")
                                           
Con_sub_plot      = ggplot(Conditional_sub, aes(x = Country, y = Beta, color = Country)) +
                    geom_point() + 
                    geom_errorbar(aes(ymin = Beta - SE, ymax = Beta + SE), width = 0.2) + 
                    theme_bw() + 
                    facet_wrap(trait ~ SNP, ncol = 3, nrow = 3, scales = "free_x") +
                    theme(legend.position = "bottom",
                          axis.text.x     = element_blank(),
                          plot.title      = element_text(hjust = 0.5)) +
                    scale_color_manual(values = country_colors) +
                    geom_hline(yintercept  = 0, linetype = "dashed", color = "red") +
                    guides(color = guide_legend(nrow = 1)) +
                    labs(x = "", y = "Effect size +/- SE")             
ggsave(paste0(path_results,"figures/GWAS/Conditional_effects_final.png"), plot = Con_sub_plot,width = 16, height = 14, unit = 'cm')
                   
